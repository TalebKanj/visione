VISIONE_ROOT=C:\temp\visione\data
VISIONE_CACHE=C:\temp\visione\cache
VISIONE_PORT=8080
VISIONE_USERNAME=admin
VISIONE_PASSWORD=admin

# ─── VRAM-aware model offloading ─────────────────────────────────────────────
# Fraction of free VRAM (0.0-1.0) required before the model is loaded onto GPU.
# Lower this on smaller GPUs (e.g. 0.5 for a 6 GB card running large models).
VISIONE_VRAM_THRESHOLD=0.85

# Offload mode: auto | cpu | disk
#   auto  → probe VRAM; fall back to CPU then SSD automatically
#   cpu   → skip GPU entirely, keep model in system RAM
#   disk  → always shard weights to VISIONE_CACHE/model_offload on the host SSD
VISIONE_OFFLOAD_MODE=auto